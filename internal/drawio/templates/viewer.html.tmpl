<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{.Title}} · draw.io</title>
  <!-- Generated by drawio-to-html. draw.io v32.6.10 via jsDelivr. Source: https://github.com/jgraph/drawio -->
  <style>
    :root { color-scheme: light dark; }
    * { box-sizing: border-box; }
    html, body, #viewer { width: 100%; height: 100%; margin: 0; overflow: hidden; }
    body { background: light-dark(#fff, #121212); font-family: system-ui, sans-serif; }
    .geDiagramContainer { position: absolute; inset: 0; overflow: hidden !important; outline: none; }
    #fallback { display: block; width: 100%; height: 100%; object-fit: contain; }
    #fallback[hidden] { display: none; }
    #status { position: fixed; top: 12px; left: 12px; right: 12px; margin: 0; padding: 10px 14px; border: 1px solid #d7cba6; border-radius: 6px; background: #fff8df; color: #594b29; font: 13px/1.6 system-ui, sans-serif; z-index: 10000; }
    #toolbar { z-index: 1000; max-width: calc(100vw - 16px); }
    #toolbar [role="button"]:focus-visible { outline: 2px solid white; outline-offset: -2px; border-radius: 4px; }
    #toolbar:focus-within { display: block !important; opacity: 1 !important; }
    @media (max-width: 480px) {
      #toolbar { padding: 8px 6px 6px !important; border-radius: 12px !important; }
      #toolbar > span { padding-left: 4px !important; padding-right: 4px !important; }
      #toolbar img { width: 26px !important; }
      #toolbar > div { margin-top: 5px !important; font-size: 12px !important; }
    }
    noscript { position: fixed; left: 12px; bottom: 12px; padding: 6px 10px; background: #fff8df; color: #594b29; font-size: 12px; }
  </style>
</head>
<body>
  <main id="viewer" aria-label="draw.io diagram viewer">
    <img id="fallback" alt="{{.Title}}" src="data:image/svg+xml;base64,{{.SVGBase64}}">
  </main>
  <p id="status" role="status" hidden></p>
  <noscript>Displaying SVG. Enable JavaScript for page and layer controls.</noscript>
  <script id="diagram-data" type="application/json">{{.DiagramJSON}}</script>
  <script>
    const assets = "https://cdn.jsdelivr.net/gh/jgraph/drawio@v32.6.10/src/main/webapp";
    window.urlParams = {
      lang: "en", offline: "1", embed: "1", lightbox: "1", math: "0", pwa: "0", "safe-style-src": "1",
      pages: "1", layers: "1", nav: "1", border: "40",
      "toolbar-config": encodeURIComponent(JSON.stringify({ noCloseBtn: true }))
    };
    Object.assign(window, {
      DRAWIO_BASE_URL: assets, PROXY_URL: "/blocked", DRAW_MATH_URL: "/blocked",
      STYLE_PATH: assets + "/styles", SHAPES_PATH: assets + "/shapes", STENCIL_PATH: assets + "/stencils",
      IMAGE_PATH: assets + "/images", GRAPH_IMAGE_PATH: assets + "/images",
      mxBasePath: assets + "/mxgraph", mxImageBasePath: assets + "/images",
      MathJax: {} // Prevent the bundle's automatic MathJax download.
    });
  </script>
  <script id="drawio-viewer" src="https://cdn.jsdelivr.net/gh/jgraph/drawio@v32.6.10/src/main/webapp/js/viewer-static.min.js" integrity="sha384-G30bc+/xkQWtFeiph1BdJMbM0rc+Nx6piGKO17mbNrUpvUR/yvjGjtIu/cHXQyyS" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script id="drawio-stencils" src="https://cdn.jsdelivr.net/gh/jgraph/drawio@v32.6.10/src/main/webapp/js/stencils.min.js" integrity="sha384-/vq36Y1oTz8y/NAfOeGGd6JIYZeSuG4OkYB7vQE2Vfn3I2MiV0cx3KZj2zyhZUlx" crossorigin="anonymous" referrerpolicy="no-referrer" onload="this.dataset.loaded = 'true'"></script>
  <script>
    (() => {
      'use strict';
      const status = document.getElementById('status');
      let noticeTimer;
      const notice = message => {
        status.textContent = message;
        status.hidden = false;
        clearTimeout(noticeTimer);
        noticeTimer = setTimeout(() => { status.hidden = true; }, 6000);
      };
      try {
        if (!document.getElementById('drawio-stencils').dataset.loaded) throw new Error('Could not load diagram stencils.');
        GraphViewer.initCss();
        Object.assign(EditorUi.prototype, {
          updateActionStates() {}, // The viewer bundle has no full editor action set.
          addChromelessClickHandler() {},
          addChromelessToolbarItems() {},
          lightboxToolbarActions: [{
            icon: Editor.fullscreenImage, tooltip: 'Fullscreen',
            async fn() {
              try {
                if (document.fullscreenElement) await document.exitFullscreen();
                else await document.documentElement.requestFullscreen();
              } catch {
                notice('Use the Notion block menu to enter fullscreen.');
              }
            }
          }]
        });
        const ui = new EditorUi(new Editor(true), document.getElementById('viewer'), true);
        const graph = ui.editor.graph;
        // Resolve built-in image paths against the CDN, as the standard viewer does.
        graph.getImageFromBundles = url => GraphViewer.prototype.getImageUrl(url);
        graph.container.style.visibility = 'visible';
        ui.editor.defaultGraphOverflow = 'hidden';
        graph.scrollbars = false;
        graph.useScrollbarsForPanning = false;
        graph.container.setAttribute('aria-label', 'Diagram canvas. Drag to pan');
        graph.getLinkForCell = () => null;
        graph.openLink = () => {};
        graph.setTooltips(false);
        graph.setPanning(true);
        graph.panningHandler.useLeftButtonForPanning = true;
        graph.panningHandler.ignoreCell = true;
        graph.panningHandler.pinchEnabled = true;
        const fit = () => { ui.lightboxFit(); ui.chromelessResize(); };
        ui.setFileData(JSON.parse(document.getElementById('diagram-data').textContent).xml);
        fit();
        const toolbar = ui.chromelessToolbar;
        toolbar.id = 'toolbar';
        toolbar.setAttribute('role', 'toolbar');
        toolbar.setAttribute('aria-label', 'Diagram controls');
        for (const button of toolbar.querySelectorAll('span[title]')) {
          button.setAttribute('role', 'button');
          button.tabIndex = 0;
          button.setAttribute('aria-label', button.title);
          button.addEventListener('keydown', event => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault(); button.click();
            }
          });
        }
        new ResizeObserver(fit).observe(document.getElementById('viewer'));
        document.addEventListener('fullscreenchange', fit);
        document.getElementById('fallback').hidden = true;
        document.documentElement.dataset.viewerReady = 'true';
      } catch (error) {
        document.querySelector('.geDiagramContainer')?.remove();
        document.getElementById('fallback').hidden = false;
        status.textContent = typeof GraphViewer === 'undefined'
          ? 'Could not load the viewer from the CDN. Displaying the SVG image.'
          : 'Could not start the viewer. Displaying the SVG image.';
        status.hidden = false;
        console.error(error);
      }
    })();
  </script>
</body>
</html>
